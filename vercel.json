{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts",
      "headers": {
        "Access-Control-Allow-Origin": "https://alertproche.com",
        "Access-Control-Allow-Methods": "GET,POST,PATCH,DELETE,OPTIONS,PUT,HEAD",
        "Access-Control-Allow-Headers": "Content-Type,Authorization,Accept,Origin,X-Requested-With,x-verify-token",
        "Access-Control-Allow-Credentials": "true"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/.well-known/assetlinks.json"
    },
    {
      "source": "/((?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
